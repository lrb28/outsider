# Copy to .env.local. Secrets remain server-side; never use NEXT_PUBLIC_.
# Production: verified-TLS Supabase pooler connection for a dedicated reader login.
DATABASE_URL=postgres://READER:PASSWORD@HOST:5432/postgres
# Optional PEM certificate for the database CA. Literal \n is accepted.
# DATABASE_CA_CERT="-----BEGIN CERTIFICATE-----\n..."
# Explicit local product preview only. Enabled only when DATABASE_URL is absent.
OUTSIDER_DEMO_MODE=false
