# Copy to .env.local. Secrets remain server-side; never use NEXT_PUBLIC_.
# Production: Supabase transaction pooler with the read-only login outsider_web
# (supabase/migrations/20260927152045_web_reader_login.sql). The ingestion keeps its own URL.
DATABASE_URL=postgres://outsider_web.PROJECT_REF:PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres
# Optional PEM certificate for the database CA; Supabase hosts use the bundled
# Supabase Root 2021 CA by default. Literal \n is accepted.
# DATABASE_CA_CERT="-----BEGIN CERTIFICATE-----\n..."
# Explicit local product preview only. Enabled only when DATABASE_URL is absent.
OUTSIDER_DEMO_MODE=false
